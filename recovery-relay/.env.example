# Jazz Recovery Relay configuration
#
# IMPORTANT:
# 1) In the Android Companion, tap "Copy Recovery Device ID" and paste that
#    exact value into JAZZ_RECOVERY_DEVICE_ID below.
# 2) Tap "Copy Recovery Pairing Token" and paste that exact value into
#    JAZZ_RECOVERY_DEVICE_TOKEN. Do NOT use the normal "Copy Bridge Token";
#    the ADB bridge token and recovery pairing token are separate credentials.
# 3) JAZZ_RECOVERY_OWNER_TOKEN is a different secret used only by you when
#    querying /status, /location, /ring, etc. Generate a long random value.
# 4) The Android app's Recovery Server URL must be the public HTTPS address
#    that forwards to this relay, e.g. a Cloudflare Tunnel URL.
#
# Never commit the real .env or real tokens.
PORT=8788
JAZZ_RECOVERY_DEVICE_ID=paste-exact-device-id-copied-from-android-companion
JAZZ_RECOVERY_DEVICE_TOKEN=paste-exact-recovery-pairing-token-copied-from-android-companion
JAZZ_RECOVERY_OWNER_TOKEN=replace-with-a-different-long-random-owner-token
JAZZ_RECOVERY_MAX_CLOCK_SKEW_MS=300000
JAZZ_RECOVERY_ONLINE_WINDOW_MS=90000
